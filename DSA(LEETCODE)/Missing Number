class Solution {
    public int missingNumber(int[] nums) {
        int numsSum = 0;
        int n = nums.length;
        int expectedSum = n * (n+1)/2;
        for(int i=0 ; i<n ; i++){
            numsSum = numsSum + nums[i];
        }
        int result = expectedSum - numsSum;
        return result;

    }
}
